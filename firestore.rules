rules_version = '2';

/* ============================================================
   GRS 보수ON — Firestore 보안 규칙

   ★ 중요 ★
   Firestore에서 하위 컬렉션은 상위 문서의 규칙을 물려받지 않습니다.
   그래서 아래 requests/{reqId}/files/{fileId} 규칙이 빠져 있으면
   사진·견적서 저장은 되어도 조회가 막혀 "사진 불러오는 중…"에서
   멈춥니다. 반드시 하위 컬렉션 규칙을 함께 게시하세요.

   또 하나 — read 는 get(문서 1건) + list(목록 조회) 를 모두 포함합니다.
   'allow get' 만 적으면 목록 조회(getDocs)가 거부되므로
   반드시 'read' 또는 'get, list' 로 적어야 합니다.

   [게시 방법]
   Firebase 콘솔 → Firestore Database → 규칙 탭
   → 화면 위쪽 데이터베이스 선택기에서 앱이 쓰는 DB를 고른 뒤
     (이 앱은 FIRESTORE_DB_ID = 'default' 를 사용합니다)
   → 아래 내용을 붙여넣고 [게시]
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* 로그인(익명 인증)된 사용자만 접근 */
    function signedIn() {
      return request.auth != null;
    }

    /* 앱 설정 (접속코드·SLA·점포목록·노임단가) */
    match /config/{docId} {
      allow read, write: if signedIn();
    }

    /* 보수공사 접수건 */
    match /requests/{reqId} {
      allow read, write: if signedIn();

      /* ★ 사진·견적서 첨부파일 — 이 블록이 핵심입니다 */
      match /files/{fileId} {
        allow read, write: if signedIn();
      }

      /* 향후 추가될 수 있는 그 밖의 하위 컬렉션까지 허용 */
      match /{sub=**} {
        allow read, write: if signedIn();
      }
    }

    /* 조명·타일 발주건 */
    match /orders/{orderId} {
      allow read, write: if signedIn();

      /* 도면·견적서·납품사진·납품확인서 서명 */
      match /files/{fileId} {
        allow read, write: if signedIn();
      }

      match /{sub=**} {
        allow read, write: if signedIn();
      }
    }

    /* 개선요청 게시판 */
    match /posts/{postId} {
      allow read, write: if signedIn();

      /* 첨부한 화면 캡처 */
      match /files/{fileId} {
        allow read, write: if signedIn();
      }

      match /{sub=**} {
        allow read, write: if signedIn();
      }
    }

    /* 채팅방 */
    match /chats/{room} {
      allow read, write: if signedIn();

      match /messages/{msgId} {
        allow read, write: if signedIn();
      }
    }
  }
}

/* ------------------------------------------------------------
   참고 — 위 규칙으로도 해결되지 않으면 아래처럼 한 줄로
   전체를 허용해 원인을 좁혀볼 수 있습니다.
   (원인 확인용이며, 확인 후에는 위 규칙으로 되돌리세요)

   rules_version = '2';
   service cloud.firestore {
     match /databases/{database}/documents {
       match /{document=**} {
         allow read, write: if request.auth != null;
       }
     }
   }
   ------------------------------------------------------------ */
